// Regole Firestore — Console Firebase → Firestore Database → Regole
// Account condiviso della band: legge e scrive tutto.
// Account degli amici (sola lettura): legge tutto; scrive solo la propria richiesta
// di ascolto della diretta, che crea e cancella. La password la gestisce la band dall'app.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function band() {
      return request.auth != null && request.auth.token.email == 'band@il-ritmo-della-sala-prove.web.app';
    }
    function amici() {
      return request.auth != null && request.auth.token.email == 'amici@il-ritmo-della-sala-prove.web.app';
    }
    match /{collection}/{doc} {
      allow read: if (band() || amici())
        && collection in ['canzoni', 'tasks', 'membri', 'registrazioni', 'movimenti', 'diretta'];
      allow write: if band()
        && collection in ['canzoni', 'tasks', 'membri', 'registrazioni', 'movimenti', 'diretta'];
    }
    match /diretta/{id} {
      allow create: if amici() && id != 'stato'
        && request.resource.data.tipo == 'ascolto'
        && request.resource.data.keys().hasOnly(['tipo', 'sessione', 'chi', 'offer', 'creato']);
      allow delete: if amici() && resource.data.tipo == 'ascolto';
    }
  }
}
