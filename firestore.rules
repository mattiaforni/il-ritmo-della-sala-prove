// Regole Firestore — Console Firebase → Firestore Database → Regole
// Leggono e scrivono solo le richieste fatte con l'account condiviso della band.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{doc} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'band@il-ritmo-della-sala-prove.web.app'
        && collection in ['canzoni', 'tasks', 'membri', 'registrazioni', 'movimenti'];
    }
  }
}
