// Regole Firestore — Console Firebase → Firestore Database → Regole
// Account condiviso della band: legge e scrive tutto.
// Account dei fan (sola lettura): legge scaletta, proposte, task, persone, registrazioni
// e diretta, non la cassa; scrive solo la propria richiesta di ascolto della diretta,
// che crea e cancella. La password dei fan la gestisce la band dall'app.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function band() {
      return request.auth != null && request.auth.token.email == 'band@il-ritmo-della-sala-prove.web.app';
    }
    function fan() {
      return request.auth != null && request.auth.token.email == 'fan@il-ritmo-della-sala-prove.web.app';
    }
    match /{collection}/{doc} {
      allow read: if (band() && collection in ['canzoni', 'tasks', 'membri', 'registrazioni', 'movimenti', 'diretta'])
        || (fan() && collection in ['canzoni', 'tasks', 'membri', 'registrazioni', 'diretta']);
      allow write: if band()
        && collection in ['canzoni', 'tasks', 'membri', 'registrazioni', 'movimenti', 'diretta'];
    }
    match /diretta/{id} {
      allow create: if fan() && id != 'stato'
        && request.resource.data.tipo == 'ascolto'
        && request.resource.data.keys().hasOnly(['tipo', 'sessione', 'chi', 'offer', 'creato']);
      allow delete: if fan() && resource.data.tipo == 'ascolto';
    }
  }
}
