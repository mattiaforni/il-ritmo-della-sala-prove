{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**/*.@(html|js|css|webmanifest|json)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "icons/**",
        "headers": [{ "key": "Cache-Control", "value": "max-age=604800" }]
      }
    ],
    "rewrites": [
      {
        "source": "/api/spotify-link",
        "function": { "functionId": "spotifyLink", "region": "us-central1" }
      }
    ]
  },
  "functions": {
    "source": "functions"
  }
}
